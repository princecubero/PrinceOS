{
  "name": "daymark-dashboard",
  "version": "1.0.0",
  "description": "A React schedule and personal finance dashboard built with Tailwind CSS and Vite.",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "node server.js",
    "db:setup": "node scripts/setup-database.js",
    "build": "vite build",
    "preview": "npm run build && node server.js",
    "start": "node server.js"
  },
  "engines": {
    "node": ">=14.16"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-router-dom": "6.3.0",
    "express": "4.18.2",
    "dotenv": "16.4.5",
    "pg": "8.11.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "1.3.2",
    "autoprefixer": "10.4.14",
    "concurrently": "7.6.0",
    "postcss": "8.4.31",
    "tailwindcss": "3.1.8",
    "vite": "2.9.16"
  }
}
